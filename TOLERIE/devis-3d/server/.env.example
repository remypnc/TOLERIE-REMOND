# Copier en server/.env et compléter. Sans SMTP, les e-mails vont dans la boîte d'envoi locale (/api/dev/outbox).
APP_URL=http://localhost:5173
# NODE_ENV=production

# Envoi des e-mails. Exemple Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=adresse gmail, SMTP_PASS=mot de passe d'application (compte Google > Sécurité > Mots de passe des applications).
# SMTP_HOST=smtp.exemple.fr
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=devis@tolerie-remond.com
# SMTP_PASS=
MAIL_FROM="Tôlerie Rémond <devis@tolerie-remond.com>"
# Alerte à l'atelier à chaque demande
# WORKSHOP_EMAIL=atelier@tolerie-remond.com

# Comptes de l'atelier : édition complète de la pièce + back-office (« Atelier ») une fois connectés.
# ADMIN_EMAILS=prenom@tolerie-remond.com,autre@tolerie-remond.com

# Jeton pour la route back-office / ERP (POST /api/admin/orders/:ref/status)
# ADMIN_TOKEN=une-longue-chaine-aleatoire

# IA générative de l'assistant (Claude). Vide = moteur de règles intégré.
ANTHROPIC_API_KEY=
# Clé non rattachée à un espace de travail : identifiant de l'espace (wrkspc_…).
ANTHROPIC_WORKSPACE_ID=
# ASSISTANT_MODEL=claude-opus-5-5
